# Copy to .env (next to where FileVow runs) and adjust. Every setting is optional.
# Secrets never go in this file: keys live in the Windows Credential Manager.

# Where the database, encrypted vault, keys and logs are kept.
# Default: %LOCALAPPDATA%\FileVow for the Windows user running FileVow.
# FILEVOW_HOME=D:\FileVowData

# SQLite in FILEVOW_HOME\data by default. PostgreSQL for larger installs (pip install ".[postgres]").
# FILEVOW_DATABASE_URL=postgresql+psycopg://filevow:change-me@localhost/filevow

# keyring = Windows Credential Manager (recommended); file = JSON file for Linux servers/dev.
# FILEVOW_KEY_STORAGE=keyring

# Scheduled full check and when a pause counts as a monitoring gap.
# FILEVOW_VERIFICATION_INTERVAL_MINUTES=15
# FILEVOW_MONITORING_GAP_MINUTES=20

# Let people create their own accounts on the sign-in screen (the first account is the administrator).
# FILEVOW_ALLOW_REGISTRATION=true

# Limit the folder browser to these roots (JSON list). Empty = all drives and the home folder.
# FILEVOW_BROWSE_ROOTS=["C:/Users", "D:/Projects"]

# Where `filevow serve` listens. The desktop app always uses 127.0.0.1.
# FILEVOW_API_HOST=127.0.0.1
# FILEVOW_API_PORT=8443

# Keep true whenever the dashboard is reached over HTTPS (server mode).
# FILEVOW_COOKIE_SECURE=true

# Only when the dashboard is served from a different origin than the API.
# FILEVOW_CORS_ORIGINS=["https://filevow.example.org"]

# Built dashboard to serve (the installed app finds its own copy).
# FILEVOW_FRONTEND_DIST=C:\FileVow\dashboard
